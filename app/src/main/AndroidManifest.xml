<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="UL Mobile Security CTF">

        <meta-data
            android:name="lu.uni.mobilectf.MANIFEST_CACHE"
            android:value="RkxBR3ttYW5pZmVzdF9tZXRhZGF0YV9kZWNvZGVkfQ==" />

        <activity android:name=".SubmitFlagActivity" />
        <activity android:name=".AboutActivity" />
        <activity android:name=".AssetChallengeActivity" />
        <activity android:name=".TapSequenceActivity" />
        <activity android:name=".WebViewChallengeActivity" />
        <activity android:name=".NativeGateActivity" />
        <activity android:name=".NetworkSyncActivity" />
        <activity android:name=".PreferencesChallengeActivity" />
        <activity android:name=".ResourceManifestActivity" />
        <activity android:name=".StorageLogActivity" />
        <activity android:name=".ProviderChallengeActivity" />
        <activity android:name=".InstrumentationLabActivity" />

        <provider
            android:name=".CampusNotesProvider"
            android:authorities="lu.uni.mobilectf.notes"
            android:exported="true" />

        <receiver
            android:name=".SecretBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="lu.uni.mobilectf.SECRET_SIGNAL" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".IntentVaultActivity"
            android:exported="true" />

        <activity
            android:name=".DeepLinkVaultActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="campusctf"
                    android:host="vault" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
